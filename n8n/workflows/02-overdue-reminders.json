{
  "id": "LendLoopRemind01",
  "name": "LendLoop - Overdue reminders (daily)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "name": "Daily 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {},
      "name": "Run now (manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.LENDLOOP_HMAC_SECRET;\nif (!secret) throw new Error('LENDLOOP_HMAC_SECRET is not set in the n8n environment');\nconst sign = (ts, body) => crypto.createHmac('sha256', secret).update(ts + '.' + body).digest('hex');\nconst ts = String(Math.floor(Date.now() / 1000));\nreturn [{ json: { ts, sig: sign(ts, '') } }];  // GET requests sign an empty body\n"
      },
      "name": "Sign GET",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CONVEX_SITE_URL }}/n8n/overdue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.sig }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const loans = ($input.first().json.loans || []).filter((l) => !l.remindedToday);\nreturn loans.map((l) => ({ json: l }));\n"
      },
      "name": "One item per overdue loan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.LENDLOOP_HMAC_SECRET;\nif (!secret) throw new Error('LENDLOOP_HMAC_SECRET is not set in the n8n environment');\nconst sign = (ts, body) => crypto.createHmac('sha256', secret).update(ts + '.' + body).digest('hex');\nconst l = $json;\nconst sentOn = new Date().toISOString().slice(0, 10);\n// Mock delivery (see README to swap in SMTP). Only the fields the reminder needs are used.\nconsole.log('[LendLoop reminder]', JSON.stringify({ to: l.borrowerEmail, tool: l.toolName, daysOverdue: l.daysOverdue }));\nconst body = JSON.stringify({ requestId: l.requestId, sentOn, idempotencyKey: l.requestId + ':' + sentOn });\nconst ts = String(Math.floor(Date.now() / 1000));\nreturn [{ json: { body, ts, sig: sign(ts, body) } }];\n"
      },
      "name": "Send reminder + sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL }}/n8n/reminder-sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.sig }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 15000
        }
      },
      "name": "Write back (idempotent)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
