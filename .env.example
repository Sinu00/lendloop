# --- Next.js / Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Convex (created by `npx convex dev`, which writes these to .env.local) ---
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Convex ENVIRONMENT VARIABLES (set in the Convex dashboard or via `npx convex env set`, NOT in Next.js) ---
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-request   (must be reachable from Convex cloud, see README)
# LENDLOOP_HMAC_SECRET=<openssl rand -hex 32>

# --- docker-compose / n8n (put in .env next to docker-compose.yml) ---
LENDLOOP_HMAC_SECRET=change-me-openssl-rand-hex-32
CONVEX_SITE_URL=https://your-deployment.convex.site
N8N_ENCRYPTION_KEY=change-me-openssl-rand-hex-16
